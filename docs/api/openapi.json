  "components": {
    "schemas": {
      "BudgetBody": {
        "properties": {
          "budget": {
            "type": "number",
            "maximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Budget"
          },
          "max_loss": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Loss"
          }
        },
        "type": "object",
        "required": [
          "budget",
          "max_loss"
        ],
        "title": "BudgetBody"
      },
      "ExitBody": {
        "properties": {
          "stop": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9.:\\-]{1,20}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop"
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9.:\\-]{1,20}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          }
        },
        "type": "object",
        "title": "ExitBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OddsBody": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/OddsHit"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Hits"
          }
        },
        "type": "object",
        "required": [
          "hits"
        ],
        "title": "OddsBody"
      },
      "OddsHit": {
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9.\\-]{0,9}$",
            "title": "Symbol"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price"
          },
          "or_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Or High"
          },
          "or_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Or Low"
          },
          "bar_index": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 76.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Bar Index"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "price"
        ],
        "title": "OddsHit"
      },
      "TimeMachineBody": {
        "properties": {
          "until": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Until"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "type": "object",
        "title": "TimeMachineBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "app__routes_analysis__ScanBody": {
        "properties": {
          "popular": {
            "type": "boolean",
            "title": "Popular",
            "default": false
          },
          "symbols": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbols"
          },
          "at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "null"
              }
            ],
            "title": "At"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          }
        },
        "type": "object",
        "title": "ScanBody"
      },
      "app__routes_paper__OrderBody": {
        "properties": {
          "client_order_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.\\-]+$",
            "title": "Client Order Id"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9.\\-]{0,9}$",
            "title": "Symbol"
          },
          "qty": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Qty"
          },
          "stop": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Stop"
          },
          "target": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Target"
          },
          "confirm": {
            "type": "boolean",
            "title": "Confirm",
            "default": false
          },
          "train": {
            "type": "boolean",
            "title": "Train",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "client_order_id",
          "symbol",
          "qty",
          "stop",
          "target"
        ],
        "title": "OrderBody"
      },
      "app__routes_swing__OrderBody": {
        "properties": {
          "client_order_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.\\-]+$",
            "title": "Client Order Id"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z]{4}\\d{1,2}$",
            "title": "Symbol"
          },
          "max_loss": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Loss"
          },
          "train": {
            "type": "boolean",
            "title": "Train",
            "default": false
          },
          "confirm": {
            "type": "boolean",
            "title": "Confirm",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "client_order_id",
          "symbol",
          "max_loss"
        ],
        "title": "OrderBody"
      },
      "app__routes_swing__ScanBody": {
        "properties": {
          "universe": {
            "type": "string",
            "enum": [
              "ibov",
              "all"
            ],
